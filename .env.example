# O institucional funciona sem servicos externos. O portal requer Supabase e configuracao descrita em docs/portal-revendedor.md.
# Nunca coloque segredos em NEXT_PUBLIC_*.
# URL pública HTTPS da loja real. Vazio mantém /loja-em-breve.
NEXT_PUBLIC_NUVEMSHOP_URL=
# URL pública HTTPS da futura área B2B. Vazio direciona para /contato?assunto=revenda.
NEXT_PUBLIC_NUVEMSHOP_B2B_URL=
# Domínio oficial HTTPS para URLs canônicas, sitemap e robots. Sem ele, o site fica noindex.
NEXT_PUBLIC_SITE_URL=
# Vitrine real: apenas no servidor. Nunca use NEXT_PUBLIC_ nestas duas variáveis.
NUVEMSHOP_STORE_ID=
NUVEMSHOP_ACCESS_TOKEN=
# Canais gerais adicionais opcionais. As unidades já têm contatos em src/config/locations.ts.
# WhatsApp: país + DDD + número, apenas dígitos.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
# Supabase opcional. Use exclusivamente a chave PUBLICÁVEL do projeto, nunca service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# PDF privado: 50 MB por padrao, compativel com o plano Free informado.
# Usar 100 somente apos confirmar plano pago + limite global + bucket de 100 MB. Exige novo build.
NEXT_PUBLIC_RESELLER_PDF_LIMIT_MB=50

# Portal de revendedores: URL/key publicavel acima + NEXT_PUBLIC_SITE_URL sao necessarios.
# Valores abaixo sao EXCLUSIVAMENTE do servidor. Nunca usar NEXT_PUBLIC_ nestes nomes.
# Chave secreta moderna Supabase (sb_secret_...), somente para o worker de notificacoes.
SUPABASE_SECRET_KEY=
# Provedor de e-mail transacional. Remetente precisa ser autorizado/verificado no provedor.
RESEND_API_KEY=
RESELLER_EMAIL_FROM=
# Destino inicial aprovado; depois alterar para contato@agylli.com e republicar.
RESELLER_NOTIFICATION_EMAIL=adm.agylli@gmail.com
